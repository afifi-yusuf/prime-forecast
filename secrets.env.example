# Copy to secrets.env and fill in. Referenced by configs/rl/*.toml via env_file.
# Also add these in the Prime Intellect dashboard (Settings > Environment Variables)
# for Hosted Training / Environments Hub.

# ------------------------------------------------------------------ search
# Backend: brave | tavily | agentcore | exa | none
PF_SEARCH_BACKEND=brave

# Brave Search API (https://brave.com/search/api/) — cheap for Hosted Training
BRAVE_API_KEY=

# Tavily (https://tavily.com) — free tier / small smokes
# TAVILY_API_KEY=

# Amazon Bedrock AgentCore Web Search (us-east-1). Create with:
#   python scripts/setup_agentcore_search.py
# AGENTCORE_GATEWAY_URL=
# AGENTCORE_GATEWAY_ID=

# Exa fallback (optional)
# EXA_API_KEY=

# ------------------------------------------------------------------ AWS
# Bedrock Runtime leak filter (bearer works on Hosted Training).
# Short-term Bedrock API keys expire (~12h) — mint a fresh one before each
# multi-hour train, or use IAM access keys below. Probe: python scripts/probe_bedrock.py
# Expired/invalid keys make web_search / lookup_url FAIL (no silent heuristic weaken).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Do NOT put AWS_PROFILE in the train env_file — remote pods have no SSO profiles.
# Local AgentCore setup only: export AWS_PROFILE=...
# IAM alternative (if you can create access keys with bedrock:InvokeModel):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# FRED macro series tool (optional, free key at fred.stlouisfed.org)
FRED_API_KEY=

# Optional overrides
# PF_LLM_FILTER=1
# To train without Bedrock at all (heuristics-only leak filter, intentional):
# PF_LLM_FILTER=0
# PF_FILTER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# PF_SUMMARIZE_MODEL=us.amazon.nova-2-lite-v1:0
