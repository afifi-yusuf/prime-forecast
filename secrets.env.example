# Copy to secrets.env and fill in. Referenced by configs/rl/*.toml via env_file.
# Also add these in the Prime Intellect dashboard (Settings > Environment Variables)
# for Hosted Training / Environments Hub.

# ------------------------------------------------------------------ search
# Backend: tavily (free tier) | agentcore (AWS) | exa | none
PF_SEARCH_BACKEND=tavily

# Tavily (https://tavily.com) — good for local eval / small smokes
TAVILY_API_KEY=

# Amazon Bedrock AgentCore Web Search (us-east-1). Create with:
#   python scripts/setup_agentcore_search.py
# AGENTCORE_GATEWAY_URL=
# AGENTCORE_GATEWAY_ID=

# Exa fallback (optional)
# EXA_API_KEY=

# ------------------------------------------------------------------ AWS
# AgentCore Gateway MCP needs IAM SigV4 (NOT the Bedrock bearer token):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock Runtime leak filter + summarizer (bearer API key OR IAM):
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY also work for Bedrock Runtime

# FRED macro series tool (optional, free key at fred.stlouisfed.org)
FRED_API_KEY=

# Optional overrides
# PF_LLM_FILTER=1
# PF_FILTER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# PF_SUMMARIZE_MODEL=us.amazon.nova-2-lite-v1:0
