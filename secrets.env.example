# Copy to secrets.env and fill in. Referenced by configs/rl/*.toml via env_file.
# Also add these in the Prime Intellect dashboard (Settings > Environment Variables)
# for Hosted Training / Environments Hub.

# Live web search (required)
EXA_API_KEY=

# Bedrock leak filter + summarizer (recommended; filter degrades to heuristics without it)
# Short-term Bedrock API key from the AWS console (preferred). Official boto3 env var:
AWS_BEARER_TOKEN_BEDROCK=
# Alias also accepted by this package:
# BEDROCK_API_KEY=
# IAM fallback (optional if using a bearer token):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# FRED macro series tool (optional, free key at fred.stlouisfed.org)
FRED_API_KEY=

# Optional overrides
# PF_LLM_FILTER=1
# PF_FILTER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# PF_SUMMARIZE_MODEL=us.amazon.nova-2-lite-v1:0
